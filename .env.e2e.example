# E2E / local secrets — copy to `.env.e2e.local` or `.env.local` (never commit real keys)
# Display brand is Data Iris; email domain below stays until DNS/domínio cutover.

E2E_ADMIN_EMAIL=admin@dataastral.com
E2E_ADMIN_PASSWORD=your-password-here
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Stripe (Embedded Checkout + Hosted Checkout)
# Publishable key is safe for the browser; secret key stays server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: canonical app URL used for Stripe return/success URLs
# NEXT_PUBLIC_APP_URL=http://localhost:3000
