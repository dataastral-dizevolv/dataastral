  --primary-foreground: 225 15% 6%;
  --secondary: 220 9% 33%;
  --secondary-foreground: 0 0% 93%;
  --muted: 225 10% 15%;
  --muted-foreground: 0 0% 58%;
  --accent: 225 10% 15%;
  --accent-foreground: 0 0% 93%;
  --destructive: 4 65% 46%;
  --destructive-foreground: 0 0% 93%;
  --border: 0 0% 93% / 0.08;
  --input: 0 0% 93% / 0.08;
  --ring: 0 0% 80%;
  --radius: 0.375rem;

  --iris-bg-primary: 225 15% 6%;
  --iris-bg-secondary: 225 12% 10%;
  --iris-bg-tertiary: 225 10% 13%;
  --iris-bg-glass: 0 0% 100% / 0.03;
  --iris-text-primary: 0 0% 93%;
  --iris-text-secondary: 0 0% 58%;
  --iris-text-muted: 0 0% 40%;
  --iris-accent: 0 0% 86%;
  --iris-accent-light: 0 0% 93%;
  --iris-accent-glow: 0 0% 86% / 0.15;
  --iris-secondary: 220 9% 33%;
  --iris-secondary-light: 220 9% 45%;
  --iris-tensao: 4 65% 46%;
  --iris-harmonia: 145 54% 42%;
  --iris-portal: 220 6% 44%;
  --iris-neutro: 0 0% 53%;
  --iris-border-accent: 0 0% 86% / 0.3;

  --sidebar-background: 225 12% 10%;
  --sidebar-foreground: 0 0% 93%;
  --sidebar-primary: 0 0% 86%;
  --sidebar-primary-foreground: 225 15% 6%;
  --sidebar-accent: 225 10% 13%;
  --sidebar-accent-foreground: 0 0% 93%;
  --sidebar-border: 0 0% 93% / 0.08;
  --sidebar-ring: 0 0% 80%;
}

@layer base {
  * {
    @apply border-border;
  }

  body {
    @apply bg-background text-foreground;
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: var(--font-display);
  }
}

@layer utilities {
  .font-display {
    font-family: var(--font-display);
  }

  .font-body {
    font-family: var(--font-body);
  }

  .font-mono-iris {
