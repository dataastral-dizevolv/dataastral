                        </button>
                      ))}
                    </motion.div>
                  ) : null}
                </AnimatePresence>

                {locationError ? <p className="text-[11px] text-red-300">{locationError}</p> : null}
              </div>
            </div>
          </section>

          <div className="flex justify-end">
            <Button type="submit" disabled={saving} className="min-w-44">
              {saving ? "Salvando..." : "Salvar Perfil"}
