      <div className="relative z-10 grid w-full grid-cols-1 items-start gap-6 border-b border-border/70 px-6 pt-24 pb-8 lg:grid-cols-12 lg:gap-8 lg:px-16 lg:pt-20 lg:pb-7">
        <div className="space-y-5 lg:col-span-5 lg:pt-2">
          <motion.h1
            initial={{ opacity: 0, y: 16 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.2 }}
