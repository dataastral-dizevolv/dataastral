# Copy to `.env.local` — do not commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Admin API, packages sync, edge proxy). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for authenticated calls to the prediction engine / edge functions.
# ENGINE_INTERNAL_TOKEN=

# Stripe Embedded + Hosted Checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Used for Stripe return_url / success_url (falls back to request origin)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# After setting keys, set each credit package's stripe_price_id in Admin → Preços
# (or via credit_packages.stripe_price_id). Without it, buy returns STRIPE_PRICE_MISSING.
